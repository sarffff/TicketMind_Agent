# 运行环境：dev | production
# production 下启动体检有问题就**拒绝启动**（占位 JWT / 占位 LLM key / 示例库口令 /
# 非本机无鉴权 Qdrant / 开着 Agent 却没设当日退款上限）。dev 只打 warning，
# 好让示例配置能把项目跑起来——但提醒要看得见。
ENV=dev

# 数据库配置
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_workspace_py

# 服务器配置
PORT=3000

# LLM API 配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.5-air
# 流式请求附带 stream_options.include_usage 以拿到真实 token 用量;
# 提供商不支持时会自动停发并改用本地估算
LLM_STREAM_USAGE=true
# 主回答调用的上界。不设的话吃 SDK 默认 600s × 3 = 最坏 1800 秒,而这条路径上
# 挂着一个数据库会话和一条 SSE 连接——连接池打满就是全站不可用。
#
# **流式下这个值的语义是"两个分片之间最多等多久",不是整条流的总时长**:每收到
# 一个分片就重置,所以正常输出的长回答不会被它切断,被拦住的是"连上了但不再吐
# 字节"的挂死连接。整条流的总长另有 AGENT_MAX_TOOL_ROUNDS 与字符预算兜着。
LLM_CHAT_TIMEOUT_SECONDS=120
# 重试 2 次:主回答没有降级路径,失败就是用户看到报错,值得多试。
# 重试只发生在开流之前,不会让用户看到重复内容
LLM_CHAT_MAX_RETRIES=2
# 辅助调用(重排/HyDE/改写/摘要)单独收紧:它们**全都有降级路径**,
# 为一个可以放弃的增强等 10 分钟是纯亏
LLM_AUXILIARY_TIMEOUT_SECONDS=60
LLM_AUXILIARY_MAX_RETRIES=1

# 模型路由(留空回退 LLM_MODEL)
# 辅助任务(历史摘要/查询改写/重排/指代消解/记忆抽取)用的便宜模型,
# 这些任务调用频次高、对推理能力要求低,与主回答同价是纯浪费
LLM_UTILITY_MODEL=
# 裁判模型:LLM-as-judge 的底线是裁判与被评模型分开(自我偏好会污染变体
# 对比结论)。留空依次回退 LLM_UTILITY_MODEL / LLM_MODEL
JUDGE_MODEL=
# 主回答的备用模型链(逗号分隔,按顺序试)。留空 = 没有降级路径。
# 补的是这个缺口:辅助调用全都有降级,唯独主回答没有——提供商对某个模型限流(429)、
# 那个模型临时 5xx、或模型名被下线(404)时,用户直接看到报错。配上之后开流之前那次
# 失败会自动换下一个模型。例:LLM_FALLBACK_MODELS=glm-4-flash,glm-4.5-air
#
# 三条边界(刻意的):只在**开流之前**切(有字节流给用户之后不切,否则备用模型会重说
# 一遍);只用**同一个 endpoint**(共用 LLM_BASE_URL/LLM_API_KEY,换的是模型名不是提供商,
# 整个提供商宕机要另配跨提供商凭证);只对 429/5xx/超时/连接失败/404 降级,400/401/403
# 直接抛(换个同端点的模型修不好请求本身的错)。
LLM_FALLBACK_MODELS=

# 跨提供商故障切换:上面那条换的是同一个 endpoint 上的模型名,挡不住"整个提供商
# 连不上"。这里配别家凭证兜底。值是 JSON 数组,按顺序试;每项 {base_url?, api_key?, model}
# ——model 必填,base_url/api_key 省略则沿用 LLM_BASE_URL/LLM_API_KEY。
# 例(SiliconFlow 兜底):
#   LLM_FALLBACK_PROVIDERS=[{"base_url":"https://api.siliconflow.cn/v1","api_key":"sk-xxx","model":"deepseek-ai/DeepSeek-V3"}]
# 顺序:主模型 -> LLM_FALLBACK_MODELS(同端点换名) -> 这里的跨提供商项。同一套降级判据
# (429/5xx/超时/连接失败/404),只在开流之前切。JSON 配坏只告警并忽略,不拖垮启动。
# 注意:成本按模型名查价目表、无 provider 维度,两家同名模型不同价时成本列分不开
# (trace 的 span 会带 fallback_provider 标出切换)。
LLM_FALLBACK_PROVIDERS=

# Embedding 配置 (留空则回退到 LLM_API_KEY / LLM_BASE_URL)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embedding-2
# 单次 embeddings 请求最多提交多少条文本(长文档分批发送)
EMBEDDING_BATCH_SIZE=32
RAG_MIN_SCORE=0.3
RAG_TOP_K=5

# 检索管线
# 稠密向量 + BM25 双路召回后 RRF 融合;关闭则退化为纯向量检索,便于对照实验
RAG_HYBRID=true
# 每条召回通道各取多少候选进入融合
RAG_CANDIDATES_PER_CHANNEL=20
# 命中分块前后各带几个相邻分块补全上下文(0 关闭)
RAG_CONTEXT_WINDOW=1
# 多查询改写:提召回,每次检索多一次模型调用
RAG_MULTI_QUERY=false
RAG_MULTI_QUERY_COUNT=2
# LLM listwise 重排:提精度,每次检索多一次模型调用
RAG_RERANK=false
RAG_RERANK_CANDIDATES=20
RAG_RERANK_SNIPPET_CHARS=500
# 重排方式: off | llm | api。留空则按 RAG_RERANK 布尔量决定(true -> llm)
#   llm — 让通用模型输出一个编号顺序。留着当对照组
#   api — 专用 cross-encoder。query 与 document 拼在一起过一遍模型输出标量相关度,
#         这是它比稠密检索准的原因:稠密是 bi-encoder,两侧各自独立编码,
#         编码时从未见过对方
#
# ⚠️ mode=api 之前:确认你的账号真的开通了 rerank。2026-08-23 实测智谱 /rerank
# 返 429 / code 1113(无该项额度),而 chat 用同一个 key 是 200。**配了没额度不会
# 报错,只会静默退回融合序**,报告里看着就是"专用重排没有增益"。
# 现在这种失败会打 warning 并带上 HTTP 状态码与 provider code(见 services/rerank.py),
# 检索报告里也会出现 degraded_stage=rerank。
#
# 已验证可用的替代(SiliconFlow,BAAI/bge-reranker-v2-m3 非 Pro 层免费):
#   RAG_RERANK_MODE=api
#   RERANK_BASE_URL=https://api.siliconflow.cn/v1
#   RERANK_API_KEY=<SiliconFlow 的 key,与 EMBEDDING_API_KEY 同一个>
#   RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_MODE=
RERANK_MODEL=rerank
# 留空回退 LLM_BASE_URL / LLM_API_KEY —— 同一家提供商时 rerank 与对话共用凭证。
# 换成别家(如上面的 SiliconFlow)时这两项都要显式填,否则会拿 A 家的 key
# 去请求 B 家的端点,表现是 401。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=10.0
# HyDE:先让模型编一段假答案,**只拿它喂稠密通道**(BM25 继续用原始 query)。
# 两路都换等于亲手废掉稀疏通道:假答案里的编号和专有名词全是编的
RAG_HYDE=false
# 原值 200 不够(见下面「辅助调用的输出预算」):假答案只有 88 字,但思考先花光
RAG_HYDE_MAX_TOKENS=2048
# 查询路由:判断偏字面还是偏语义,据此调 RRF 两路权重。
# eval 数据集的 probe 标注天生就是这个分类器的标注集,所以它的准确率可测
RAG_QUERY_ROUTE=false
RAG_RRF_DENSE_WEIGHT=1.0
RAG_RRF_SPARSE_WEIGHT=1.0
RAG_ROUTE_WEAK_WEIGHT=0.4

# 辅助调用的输出预算
# 这几个数是实测出来的,不是调参空间。glm-4.5-air 这类混合推理模型会先花
# max_tokens 思考,预算不够时返回**空串**(不是截断的 JSON)。而每个调用方都
# 合理地把失败当成"这是增强不是依赖"静默降级,于是:
#   路由/HyDE/多查询/重排 四个增强从未真的执行过,
#   eval/variants.py 里对应的 5 个变体与 baseline 逐位相同,
#   报告上读作"这个技术没有增益"。
#
# 两个脚本配套验收,顺序不能反:
#   scripts/probe_structured_budgets.py   七个调用点是不是全都活着(快)
#   scripts/sweep_worst_case_budgets.py   按输入上界扫最低通过值(慢,但必须)
# 第二个不能省:第一个用玩具输入,对"输入随配置增长"的调用点会给假绿灯。
# 实测 rerank 在 5 个候选下 1024 通过、在生产的 20 个候选下 3072 才通过。
#
# 为什么可以大方给:max_tokens 是**上界不是账单**,计费按真实输出 token。
# 而失效那侧要为思考的 token 全额付费然后拿回一个空串。
# 现在这类失效会被记下来:finish_reason=length 且正文为空时打 warning,
# 并在 span 上落 truncated / structured.<purpose>.budget_exhausted。
RAG_ROUTE_MAX_TOKENS=2048
RAG_MULTI_QUERY_MAX_TOKENS=2048
# 输入随 RAG_RERANK_CANDIDATES × RAG_RERANK_SNIPPET_CHARS 放大,所以给得最多。
# 合成语料扫出来的下限是 3072,但真实语料下 6144 仍有约 12% 返回空串——
# 输入会被配置放大的调用点必须按真实数据校准,合成输入只给下界
RAG_RERANK_MAX_TOKENS=12288
# 指代消解是唯一默认开启的受害者:每一次追问都在拿原文检索

# 摄取层清洗
# 脏输入不是"质量差一点",它会让召回通道整条失效:GBK 文档被 errors="replace"
# 变成一串 U+FFFD 之后 tokenize() 返回空,BM25 建索引时整块跳过——稀疏通道
# 彻底看不见这篇文档,而状态还是 indexed。关掉即退回改动前的行为(对照组)
INGEST_CLEAN=true
# 非 utf-8 文档的解码先验(逗号分隔,按顺序严格试)。
# 为什么需要先验:同一串中文字节在 GB18030 / EUC-KR / Shift-JIS 下都能严格解通,
# 从字节本身分辨不了,任何检测器都不行(实测一段 GBK 短句会被判成 EUC-KR)。
# 代价:一份真正的韩文文档会被当成中文解错
INGEST_ENCODING_HINTS=gb18030
# 用 pdfplumber 的字号与坐标恢复标题层级、剔页眉页脚、修词内空格。
# 这是让 chunking 那四件事对 PDF 重新生效的唯一途径:PyPDF2 只给字符串没有字号。
# 开着时 pdfplumber 是必需依赖,缺了会拒绝启动(静默降级会让 eval 结论依赖环境)
INGEST_PDF_STRUCTURE=true
# 可读字符占比(1 − U+FFFD 替换符占比)低于此值即判 failed。
# 2026-08-23 从 0.6 提到 0.9:实测 GBK 文档硬解 utf-8 后 ratio 落在 0.2755–0.6547
# (ASCII 越多上界越高,技术文档中文全毁也能拿 0.65),有一篇 0.6011 刚好过了旧门槛,
# 状态 indexed 但 BM25 只剩 ASCII 残留、中文查询全不命中。正常语料实测都是 1.0000,
# 与坏文档之间是大片空白,所以 0.9 零误伤。**不要往回调到 0.6。**
INGEST_MIN_TEXT_RATIO=0.9
# 页眉页脚的判据是"在至少这么多页的相同边缘区域重复出现"
INGEST_HEADER_FOOTER_MIN_PAGES=3
# 索引完成后抽一块回去检索,命中不了自己就记 warning。
# 这是把"索引成功"的判据从"没抛异常"换成"真的检索得到"
INGEST_SELF_CHECK=true

# ---- 扫描件 OCR 兜底 ----
# 上面那道 no_chunks 自检只能把"扫描件抽不到字"从静默失败变成一条 failed,它兜不住
# 的是"让这篇文档真的进库"。扫描件 PDF(只有图像层、没有文本层)在 extract_pdf 里落
# no_text_layer、正文为空,而企业库里合同、证照、历史存档恰恰大量是扫描件。
# 打开后:create_document 解析出 no_text_layer / no_extractable_text 时,把每页渲染成
# 图片交给视觉模型转写,结果当正文走后续正常的分块/自检链路。默认关——打开一个入口
# 就是把它的失败模式和成本一起打开:每页一次模型调用,成本随页数线性涨。
# 视觉模型而非 tesseract:项目已有 OpenAI 兼容多模态(见 services/vision.py),不引入
# 外部二进制;渲染走 pdfplumber(0.11+) 的 to_image(pypdfium2,同样无外部二进制)。
# OCR 用的视觉模型名。必须显式配,且必须在 VISION_MODELS 白名单里(给非视觉模型发图
# 只换来 400)。留空 = 即便 INGEST_OCR_ENABLED=true 也不生效,启动会打 warning——
# 静默退回"没 OCR"会让"为什么扫描件还是没进库"变成查不出的问题。例:glm-4v
# 单篇最多 OCR 几页。扫描件动辄上百页,不封顶一次上传就能打爆配额。超出的页不转写,
# 落一条 ocr_page_limit 告警(入库的是前 N 页,不是整篇失败)。
# 页面渲染分辨率(DPI)。太低字糊 OCR 质量掉,太高请求体和 token 都涨。150 是折中。
# 单页转写结果低于这么多字符就当这页没抽到(空白页/插图页),跳过并计数。

# ---- 入库任务队列（持久化，替代进程内 fire-and-forget）----
# 改动前上传后的索引是 FastAPI BackgroundTasks：同事件循环、不落盘、无并发上限、无
# 重试，进程在索引中途重启那篇就永远卡在 processing。现在换成 document_jobs 表 + 认领/
# 租约/重试，照搬 agent_runs 的 reaper（惰性挂在知识库读路径与启动，无调度器）。
# 一个进程里最多同时索引几篇（索引慢在 embedding 的 N 次网络调用，并发太高打爆端点）
INGEST_QUEUE_CONCURRENCY=2
# 认领一篇后租约多久过期；超过没完成即判为认领它的进程死了、重新入队。给得宽：
# 一篇大文档的 embedding 可能要几分钟
INGEST_QUEUE_LEASE_SECONDS=600
# 一篇最多尝试几次（瞬时失败值得重试，到顶仍失败即落 failed）
INGEST_QUEUE_MAX_ATTEMPTS=3
# 重试退避基数（秒），实际等待 = 基数 × 已尝试次数
INGEST_QUEUE_BACKOFF_SECONDS=30

# 向量存储
# memory | qdrant
# memory 是进程内 FAISS/numpy 索引,每次进程重启从 MySQL 重建。限制很具体:
# **多 worker 部署时每个 worker 各建一份**,于是一次上传之后哪个 worker 能检索到
# 取决于请求打到了谁身上。qdrant 把向量变成持久态:多 worker 共享、重启不丢。
# 切换是显式动作 —— 它需要一个跑着的服务(docker-compose.qdrant.yml)。
# 设了 WEB_CONCURRENCY>1(多 worker)却仍是 memory 时,启动会打一条告警(见
# main._check_multiworker_vector_store)。横向扩之前请切 qdrant 并设 QDRANT_API_KEY。
VECTOR_STORE=memory
# exact | hnsw(只作用于 memory 后端)。
# exact 是暴力扫描,召回率恒 100%。hnsw 拿召回换延迟,**在当前语料规模下只会更差**
# ——它存在的意义是让"ANN 的代价"变成能量出来的数,而不是一句口号
VECTOR_ANN=exact
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCT=100
VECTOR_HNSW_EF_SEARCH=64
QDRANT_URL=http://localhost:6333
# Qdrant 默认无鉴权。暴露到公网时必须设,否则等于把整个知识库向量公开
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_workspace_chunks
QDRANT_TIMEOUT_SECONDS=5.0

# 分块配置
# token 计数器: heuristic(零依赖估算) | tiktoken(精确,需额外安装且首次会下载词表)
TOKEN_COUNTER=heuristic
CHUNK_MAX_TOKENS=320
# 仅在单个超长块被硬切时生效;跨段上下文由检索阶段的邻域扩展补全
CHUNK_OVERLAP_TOKENS=40
# structural | semantic
# structural 按 Markdown 结构切(标题层级、代码围栏、段落),零成本。
# semantic 按相邻句向量的余弦距离找断点——话题真正转折的地方才断,而不是恰好
# 写了个空行的地方;代价是入库时 embedding 调用量大约翻倍(句向量找边界 +
# 块向量建索引)。检索侧不多花一分钱。
# 不做 late chunking:它需要 token 级 hidden states,而 /embeddings 只返回池化向量
CHUNK_STRATEGY=structural
CHUNK_SEMANTIC_PERCENTILE=95.0
CHUNK_SEMANTIC_MIN_SENTENCES=6

# 对话历史
# 历史消息的 token 预算(不含系统提示词与当前问题)
# 每轮从数据库取回多少条备选,再由 token 预算决定保留几条
# 超出预算的早期历史压成滚动摘要(关闭则直接丢弃)
# 七个辅助调用点里输入唯一没有硬截断的一个:滑出预算的历史有多少就压多少。
# 实测最低 2048(提示词 15945 字),400 和 1024 都返回空串——空摘要会让这个
# 开关静默退化成 false。这个数管两件冲突的事:给思考的余地 + 摘要长度上限
# (摘要要进 HISTORY_TOKEN_BUDGET)。API 只有一个旋钮,所以这里给够思考,
# 长度靠 prompts/history_summary/ 那句"压缩成要点摘要"约束。摘要变啰嗦时
# 去提示词里加字数上限,不要把这个数调小。

# 语义缓存
# 默认关闭：嵌入向量对时间、否定这类"改变答案"的差异不敏感，
# 命中一条相似但不同的问题会直接答错。开启即接受这个取舍。
# 余弦相似度阈值，应该用评估集扫出来而不是拍脑袋

# 安全护栏
# 关闭后检索内容原样拼进提示词(仅建议排查护栏误报时临时关闭)
GUARDRAIL_ENABLED=true
# 注入模式累计分数达到该值时整段检索结果不再注入,0 = 只标记不拦截。
# 默认只观测:误报的表现是"明明有资料却答不出来",比漏报更难排查。
GUARDRAIL_BLOCK_SCORE=0

# 出站出口控制(SSRF + 白名单,见 services/egress.py)
# 模型可控的出站只有 fetch_web_page(URL 由模型给)。默认拦私网/环回/链路本地/保留段
# (含云元数据 169.254.169.254),几乎无误报,挡的是"把抓网页变成探内网/读云凭证"。
# 运营方自己配的 endpoint(LLM/embedding/rerank/web_search/Qdrant 的 host)不受此限。
EGRESS_BLOCK_PRIVATE_IPS=true
# 额外放行的出站 host(逗号分隔,支持 *.example.com 通配)。
# 空 = 只做 SSRF 拦截、放行任意公网 host;非空 = 把 fetch_web_page 收紧到"运营方
# endpoint + 这里列的 host",其余一律拒。例:EGRESS_ALLOWLIST=*.gov.cn,docs.python.org
EGRESS_ALLOWLIST=

# 提示词版本
# 正文在 back-end/prompts/<key>/<version>.md,这里只选用哪一版。
# 改这个只改默认值:界面上的提示词实验台是按请求覆盖的,不会写到这里。
#
# 这几项都是**覆盖项**,留空 = 用 prompt_library.SPECS 里的 default_version。
# 那儿才是默认版本的事实来源(紧挨着该 key 的占位符契约),这里写死一个版本号
# 就等于把同一个值抄了两遍。启动日志会打出真正生效的版本,以那个为准。
#
# 想固定某一版时再填,例如回归排查、或按下面 AGENT_DELEGATION_MODE 的要求配对。
# 离线评估用的回答提示词。eval/variants.py 会覆盖它做 A/B,
# 所以跑评估时这里配什么都不影响报告里的数字。
PROMPT_EVAL_ANSWER_VERSION=
# 子代理提示词。三个角色各自一项——共享一个开关就没法单独 A/B 某个角色。
# 只在 AGENT_DELEGATION_MODE 不是 off 时才有意义。
PROMPT_TICKET_SUB_INQUIRY_VERSION=
PROMPT_TICKET_SUB_POLICY_VERSION=
PROMPT_TICKET_SUB_REASSURANCE_VERSION=

# 时区
# 应用写入 naive DATETIME 列时用的时区偏移(小时),必须与数据库服务器墙上时间一致。
# 业务表的 created_at 用 MySQL 的 func.now(),这里配错会让消息时间和 trace 时间错开。
APP_TZ_OFFSET_HOURS=8

# 可观测性
# 关闭后所有埋点变成空操作,不写 trace_spans 表
TELEMETRY_ENABLED=true
# 单条 span 的 attributes JSON 上限(只存元数据,不存提示词)
TELEMETRY_ATTR_MAX_CHARS=2000
# 价目表路径,文件不存在时成本一律显示为"未知"
# 复制 model_prices.example.json 为 model_prices.json 并填入真实价格
PRICING_CONFIG_PATH=model_prices.json
# /metrics/usage 的默认统计窗口(天)
METRICS_DEFAULT_DAYS=7

# ---- 用量闸门(按用户,不是按 IP) ----
# 三个上界互相独立,分别防三件事,全为 0 等于关闭:
#   频率  防滥用。进程内计数,每个请求都算(包括早早失败的)
#   成本  防超支。读 trace_spans.cost,也就是真实记账
#   token 成本的兜底。价目表里没有的模型 cost 是 NULL,只卡成本会被绕过
#
# 为什么不用 slowapi:它按 IP 限流(同一间办公室的人会被算成一个),而且表达不了
# 成本配额。详见 services/usage_guard 的模块文档。
USAGE_GUARD_ENABLED=true
# 频率:窗口(分钟)与窗口内的请求数上限
USAGE_RATE_WINDOW_MINUTES=1
USAGE_RATE_MAX_REQUESTS=20
# 成本与 token 的统计窗口(小时)。滑动窗口,不按自然日对齐——按自然日对齐会在
# 午夜给出一整份新配额,"卡住了就等到零点"就成了一种可行的绕过方式
USAGE_QUOTA_WINDOW_HOURS=24
# 每用户每窗口的成本上限,单位与 model_prices.json 的 currency 一致。0 = 不限。
# 混币种时各币种独立比较,不做汇率换算(项目里没有汇率来源)
USAGE_QUOTA_MAX_COST=0
# 每用户每窗口的 token 上限(输入+输出)。0 = 不限。
# 默认给 2,000,000:成本上限在生产模型未定价时是"假闸门",token 上界才是真正的
# 防跑飞兜底。量出来的——单回合平均 ~7,600 token,2M≈260 个平均回合,拦不住真人
# 正常一天,却把跑飞脚本从"两亿"压到"两百万"。私有化部署按自己的 trace_spans 调。
USAGE_QUOTA_MAX_TOKENS=2000000

# ---- 线上健康监控与主动告警 ----
# usage_guard 防的是单个用户跑飞;这里看的是整条线作为一个整体是不是在变坏——
# 错误率爬升、人工介入变多、单次回答变贵。离线金标跑在温度 0、固定语料上,线上是
# 温度 0.7、真实流量,两套分布;这补的是"线上这半环"。越阈值经应用内通知推给管理员。
# 默认关。没有内置定时器:评估顺带挂在通知未读数轮询上(前端徽标心跳),也可以让外部
# cron 打 GET /metrics/health。多 worker 下各评估一次,靠"每人同时只留一条未读健康
# 告警"去重吸收重复。指标与阈值判定见 services/production_monitor.py。
MONITOR_ENABLED=false
# 聚合窗口(小时),滑动窗口
MONITOR_WINDOW_HOURS=24
# 样本不足不告警:窗口内主代理 run 数低于此值直接跳过(小样本的比例是噪声)
# 两次真正评估的最小间隔(分钟)。挂在高频读路径上靠它节流:间隔内只是一次时间戳比较
MONITOR_INTERVAL_MINUTES=15
# 四条阈值各自独立,0 = 关掉这一条(同 usage_guard 的约定)
# 错误率 = 失败的主代理 run / 全部主代理 run
MONITOR_MAX_ERROR_RATE=0
# 人工介入率 = (被审批打断过 或 无人裁决而废弃)的 run / 全部 run
MONITOR_MAX_INTERVENTION_RATE=0
MONITOR_MIN_TICKETS=20
MONITOR_MAX_COST_PER_TICKET=0
MONITOR_MAX_P95_HANDLE_MS=0
# 单次回答平均成本上限。混币种相加有汇率问题,所以默认 0(同 USAGE_QUOTA_MAX_COST):
# 生产模型未进价目表时成本是 NULL,配非零只得到永不触发的假闸门
# 端到端延迟 p95(毫秒),按 agent_runs 的 finished-started 算。0 = 不看

# Agent 循环配置
# 单次回答允许的最大模型轮次;最后一轮不下发工具,强制模型作答
# 单个工具结果注入上下文的字符上限
# 一次回答中所有工具结果的总字符预算
# 同一个 (工具, 参数) 在一次回答里最多执行几次,第 N 次起不再执行,改为回灌一句
# 纠正说明("这条路走过了,换参数或直接作答")。轮次上限和字符预算都管不到重复
# 调用——它每次都是合法调用、都在预算内,只是拿回来的东西一模一样。
# 0 = 关闭检测。算的是总次数不是"连续三次":在两个相同查询之间来回摆是同一种病。
AGENT_REPEAT_LIMIT=3

# 结构化输出
# 模型返回的 JSON 解析或 Pydantic 校验失败时的重试次数。重试会把校验报错原文
# 回灌给模型让它自己改(和工具参数校验失败时回灌 INVALID_ARGUMENTS 同一套路)。
# 作用于:多查询改写、listwise 重排、记忆抽取、LLM 裁判。
# 0 = 不重试,各调用方直接走降级路径(用原查询/用融合序/这轮不记记忆)。
STRUCTURED_OUTPUT_RETRIES=1

# 工单域(客服 + 工单解决 Agent)
# 总开关。默认关:关着时工单路由不注册、业务工具不注册,对话与知识库的行为
# 逐位等价于加这套东西之前——"上线出问题就把开关拨回去"不该需要一次回滚部署。
# 打开还需要迁移 0021/0022(工单表 + 业务靶子表)。
TICKET_AGENT_ENABLED=false
# 受理哪些渠道,与代码里的渠道清单取交集(手抄成 emial 不会静默收下,而是那条
# 渠道根本不生效)。默认只放已经有入口适配器的四个;wecom/phone 要等接上转写。
TICKET_CHANNELS=web_chat,email,app,api
# 工单正文字符上限。**超限报错而不是截断**:被切掉的尾部往往正是订单号与诉求,
# 而一张缺订单号的工单会走到"查不到订单"再转人工,看起来安全实际是我们扔了信息。
TICKET_INTAKE_MAX_CHARS=6000
# 附件条数上限。超了多半是把整封邮件线程连着附件一起转发了
TICKET_INTAKE_MAX_ATTACHMENTS=8
# SLA 时限(小时),建单时据此写 sla_due_at。0 = 不设。
# 有这一列是因为"首次响应时间/平均处理时长"只有在**当时**记下的时限上才有意义,
# 事后用一个统一标准倒推等于用今天的口径审判历史。
TICKET_SLA_HOURS=24
# 治理:限额与熔断。这三项都可以被某个工作区的 governor 行覆盖(运行时可改,
# 事故当中不用等重启),这里是"没配过治理的工作区"的默认值。
# 每日退款总额上限(元,按应用时区自然日)。默认给得很小是对的:刚接上真实支付
# 通道时应该"几乎一切都过人审",再按观测到的错误操作率逐步放宽——默认放宽等于
# 在没有任何数据的时候假定 Agent 是对的。0 = 一律不许自动退。
TICKET_DAILY_REFUND_LIMIT=1000
# 单工单模型成本上限(元),0 = 不限。烧了多少钱与这张工单该不该自动解决是两件
# 不相干的事,不该让前者绑架后者。
TICKET_MAX_COST_PER_TICKET=0
# 单工单工具调用次数上界,0 = 不限
TICKET_MAX_TOOL_CALLS=12
# 退款金额的人审阈值(元)。达到它就进人审。这也是"错误操作率"这个指标的定义
# 本身,不是一个可调的小数点。0 = 任何退款都要人批。
TICKET_REFUND_REVIEW_THRESHOLD=200
# 法律/投诉关键词(逗号分隔),命中即高风险:这类工单的代价不是钱,是法务与舆情。
# 用关键词而不是让模型判断有没有法律风险,因为这条要的是宁可多转。
TICKET_LEGAL_KEYWORDS=律师,起诉,法院,仲裁,315,消协,工商,市场监管,曝光,媒体,维权
# 强负面情绪词(逗号分隔),命中两条以上算情绪极负面
TICKET_NEGATIVE_KEYWORDS=垃圾,太差,骗子,欺诈,愤怒,气死,无语,崩溃,投诉,差评,离谱
# 抽取走不走模型。关掉只留规则层(订单号/金额/意图/关键词),商品名与情绪判定
# 就没有了——那是一个明确的降级面,而不是悄悄变笨。
TICKET_UNDERSTAND_LLM=true
# 办单之前要不要先规划几步(文档第 5 步)。默认开:这份计划的读者主要是审批人和
# 事后回放——"它打算先查单再退款"写在工单上,人批那笔退款时才知道自己批的是第几步。
TICKET_PLAN_ENABLED=true
# 计划步数上限。工单不是研究课题,超过 5 步的计划基本是在给简单问题硬凑步骤。
TICKET_PLAN_MAX_STEPS=5
# LangGraph 检查点文件的位置:挂在人审上的那张工单,状态就存在这里。
# 必须是活得比进程长的路径(放临时目录等于把"跨天恢复"换成"重启即失忆");
# 多实例部署要换成共享存储或 Postgres saver——两个进程各写一份 sqlite,
# 会得到两条互不知情的挂起线程。
TICKET_CHECKPOINT_DB=back-end/ticket_checkpoints.db
# 回复出口(要发给客户的话与邀评)。没有接任何通道时 pending 会一直留着——
# 那是"欠客户一个回复"的可见证据,不会被悄悄标成 sent。
# 租约秒数要明显长于一次外发的超时:比它短就会出现"进程还在发、租约到期、
# 第二条进程又发一遍",对客户端就是一封重复的邮件。
TICKET_OUTBOX_LEASE_SECONDS=120
TICKET_OUTBOX_MAX_ATTEMPTS=3
# 退避基数,实际间隔是 基数 × 已尝试次数
TICKET_OUTBOX_BACKOFF_SECONDS=60
# 办结后顺带排一条邀评。CSAT 是文档列的核心指标,而没人被邀请过之后,
# 这个指标只能等客户自己上门骂一句时才有一条数据。
TICKET_CSAT_INVITE_ENABLED=true
# 自动排空待发队列。默认关——和这里每一样新能力一样：出问题要能用一条配置拨回去,
# 而不是回滚部署。
#
# 关着的时候只有治理台上那个手动按钮会去 drain,于是"办结的回复什么时候发出去"
# 取决于有没有人恰好去点一下,不点队列只会变长。
#
# 打开之前先确认 services/ticket/senders.py 的 build_sender() 真的返回一个通道。
# 现在它返回 None(邮件/企微/短信一种都没接),那种情况下这个循环每 N 秒醒来一次、
# 发现没有出口、再睡回去——第一次会警告一句,之后不再刷日志,但也不会发出任何东西。
TICKET_OUTBOX_AUTODRAIN=false
TICKET_OUTBOX_DRAIN_INTERVAL_SECONDS=30
TICKET_OUTBOX_DRAIN_BATCH=10

# ========== 外发通道：SMTP ==========
# 留空 host = 没有邮件通道,行为与之前完全一致：队列只增不减,治理台如实说
# "没有接入任何发送通道"。半套配置(host 给了但 FROM 空着、SECURITY 拼错)一律
# 按"没配"处理并说明缺了什么——否则第一次排空会连着失败几条,而报错看起来像
# 服务商的问题,没人会想到是没填发件地址。
#
# 只覆盖 email 这一个工单渠道。web_chat / app / wecom 的行不会被邮件通道领走,
# 它们继续躺在 pending 里被看见——用邮件把网页会话的回复标成"已发送"是一次
# 不存在的送达,比不发更坏。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SUBJECT_PREFIX=【客服工单】
# starttls(默认,587) | ssl(465,隐式 TLS) | none(本机 relay 之类)
# none 会把凭据和正文明文发出去,用得上它的人应当知道自己为什么用得上。
# 两条都始终验证服务器证书：要连自签名的内部 relay,请把 CA 装进系统信任链,
# 而不是在代码里关掉校验。
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15

# 多代理协作(委派)
# off        : 单代理,一张工单由主代理自己走完(默认)
# augment    : 主代理保留全部工具,额外多一个 delegate,自己判断什么时候值得派人
# supervisor : 查询类工具从主代理手里收走,只留 delegate、写操作与 load_skill
#
# 开之前先在工单轨迹回放里看清单代理模式究竟是哪一步不够用:每次委派都是一个完整的
# 嵌套子代理循环,成本与延迟都会上去,而这在任何一次单独调用里都看不出来。
#
# 写操作任何模式都不进子代理的工具面。委派出去的执行**不过人在回路**——审批闸门在
# 主循环按提议判,而子代理跑在一个工具处理器里面。理由见 services/agent_roles.py。
AGENT_DELEGATION_MODE=off
# 一张工单最多委派几次。子代理内部的工具调用**也**计入 TICKET_MAX_TOOL_CALLS,
# 所以这个上限管的是"另起几个独立上下文",那才是成本与延迟的真正来源。
AGENT_MAX_DELEGATIONS=2
# 子代理每次工具结果回灌给它的字符上限。它的结果会连同报告一起回到主代理的上下文里,
# 不加这道截断,一次委派就能把三张订单的全文带回来,而主代理要的只是那一句结论。
AGENT_SUBAGENT_RESULT_MAX_CHARS=4000

# 作业指导（SOP skills）
# 内置那份在 skills/refund-playbook/SKILL.md，admin 也能在工作区里自己写（同名覆盖内置）。
#
# 默认关：开着它等于每张工单多一条 system 消息（只有名字和一句用途的索引），
# 正文由模型自己调 load_skill 取——所以成本取决于"加载了几份"，即 SKILL_MAX_LOADS。
SKILL_ENABLED=false
# 一张工单最多加载几份正文。没有上限时模型会把索引里每一份都读一遍再动手，
# 那是最贵的一种"稳妥"。
SKILL_MAX_LOADS=3
# 索引里最多列几条。超出时会在索引里如实说明被截断——不说的话模型会以为清单是完整的。
SKILL_INDEX_MAX_ITEMS=40
# 单份正文的字符上限（保存时校验，超了直接拒）。一份完整流程带上判据与例外，
# 几千字是正常的，所以这里给得比想象中宽。
SKILL_MAX_CHARS=8000
# 附带文件单次读取的字符上限。
SKILL_ATTACHMENT_MAX_CHARS=4000

# 网页抓取(知识库 from-url 与工单里的链接)
WEB_FETCH_MAX_BYTES=204800
WEB_FETCH_TIMEOUT_SECONDS=10.0

# Redis 配置 (可选)
REDIS_URL=redis://localhost:6379/0

# JWT 认证配置
JWT_SECRET_KEY=your-secret-key-change-this-in-production-please-make-it-very-long-and-random
JWT_ALGORITHM=HS256
